[importlinter]
root_package = xolotl
include_external_packages = True

[importlinter:contract:platform-does-not-import-modules]
name = platform imports nothing from modules
type = forbidden
source_modules =
    xolotl.platform
forbidden_modules =
    xolotl.modules

[importlinter:contract:no-upward-imports-of-composition-roots]
name = platform and modules never import the composition roots
type = forbidden
source_modules =
    xolotl.platform
    xolotl.modules
forbidden_modules =
    xolotl.app
    xolotl.cli

[importlinter:contract:screening-library-is-pure]
name = the screening library imports only platform errors and enums (SP-03 spec section 2)
type = forbidden
source_modules =
    xolotl.modules.screening.lists
    xolotl.modules.screening.matching
forbidden_modules =
    sqlalchemy
    fastapi
    xolotl.modules.party
    xolotl.platform
ignore_imports =
    xolotl.modules.screening.lists.** -> xolotl.platform.errors

[importlinter:contract:screening-catalog-is-party-free]
name = the list catalog never imports the party module
type = forbidden
source_modules =
    xolotl.modules.screening.catalog
forbidden_modules =
    xolotl.modules.party
# The private-list template normalizes RFC and CURP with the party validators' rules
# (SP-03a Deviation 7); both modules are pure and touch no party table or service.
ignore_imports =
    xolotl.modules.screening.catalog.template -> xolotl.modules.party.identifiers
    xolotl.modules.screening.catalog.template -> xolotl.modules.party.enums

[importlinter:contract:screening-lists-never-imports-matching]
name = screening.lists never imports screening.matching
type = forbidden
source_modules =
    xolotl.modules.screening.lists
forbidden_modules =
    xolotl.modules.screening.matching

[importlinter:contract:screening-engine-reads-party-through-services]
name = screening engine reads parties through services
type = forbidden
source_modules =
    xolotl.modules.screening.engine
    xolotl.modules.screening.review
    xolotl.modules.screening.rescreen
forbidden_modules =
    xolotl.modules.party.models
ignore_imports =
    xolotl.modules.party.service -> xolotl.modules.party.models

[importlinter:contract:monitoring-core-is-pure]
name = the monitoring core imports no database, web framework or other module (SP-04 spec section 2)
type = forbidden
source_modules =
    xolotl.modules.monitoring.txn.schema
    xolotl.modules.monitoring.aggregates.declarations
    xolotl.modules.monitoring.aggregates.windows
    xolotl.modules.monitoring.aggregates.store
    xolotl.modules.monitoring.aggregates.memory
    xolotl.modules.screening.counterparty.schema
forbidden_modules =
    sqlalchemy
    fastapi
    xolotl.platform
    xolotl.modules.party
    xolotl.modules.screening.engine
    xolotl.modules.screening.catalog
    xolotl.modules.tenants
    xolotl.modules.reporting
ignore_imports =
    xolotl.modules.monitoring.txn.schema -> xolotl.modules.party.schemas
    xolotl.modules.screening.counterparty.schema -> xolotl.modules.party.schemas
    xolotl.modules.screening.counterparty.schema -> xolotl.modules.party.enums
    xolotl.modules.monitoring.aggregates.windows -> xolotl.platform.policy.durations

[importlinter:contract:monitoring-boundaries]
name = monitoring reads parties and counterparties through services and never imports reporting
type = forbidden
source_modules =
    xolotl.modules.monitoring
forbidden_modules =
    xolotl.modules.reporting
    xolotl.modules.party.models
    xolotl.modules.screening.counterparty.models
    xolotl.modules.screening.engine.models
# A10 adds "...counterparty.views -> ...counterparty.models" with its module: an
# ignore line that matches nothing fails the gate.
ignore_imports =
    xolotl.modules.party.service -> xolotl.modules.party.models
    xolotl.modules.screening.counterparty.resolve -> xolotl.modules.screening.counterparty.models
# C1: resolve's first-sight hook indexes a new row's name (plan 4c Deviation 5); it
# and the name index writer reach the counterparty models, never the engine's.
    xolotl.modules.screening.counterparty.first_sight -> xolotl.modules.screening.counterparty.models
    xolotl.modules.screening.counterparty.names -> xolotl.modules.screening.counterparty.models

[importlinter:contract:screening-never-imports-monitoring]
name = screening never imports monitoring (SP-04 spec Decision 18)
type = forbidden
source_modules =
    xolotl.modules.screening
forbidden_modules =
    xolotl.modules.monitoring

[importlinter:contract:monitoring-evaluator-is-pure]
name = rule definitions, the evaluator and the capture definitions are pure (plan 4b Global Constraints, Deviation 1)
type = forbidden
source_modules =
    xolotl.modules.monitoring.rules.definitions
    xolotl.modules.monitoring.rules.render
forbidden_modules =
    sqlalchemy
    fastapi
    xolotl.modules.screening
    xolotl.modules.party.models
    xolotl.modules.party.service
    xolotl.platform
# The platform modules the pure set may read (each pure itself), and 4a's pure
# transaction schema, which takes the counterparty input types from screening's
# pure schema module. import-linter refuses a source module that does not exist,
# so B2 (rules.kinds), B3 (rules.library) and B10 (captures.definitions) add their
# module and its ignore lines here; an ignore line that matches nothing fails too.
ignore_imports =
    xolotl.modules.monitoring.rules.definitions -> xolotl.platform.policy.durations
    xolotl.modules.monitoring.rules.definitions -> xolotl.platform.policy.jurisdictions
    xolotl.modules.monitoring.rules.definitions -> xolotl.platform.units.rules
    xolotl.modules.monitoring.txn.schema -> xolotl.modules.screening.counterparty.schema
