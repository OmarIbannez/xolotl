XOLOTL_DATABASE_URL=postgresql+psycopg://xolotl_app:xolotl@localhost:5432/xolotl
XOLOTL_DATABASE_ADMIN_URL=postgresql+psycopg://xolotl:xolotl@localhost:5432/xolotl
# A host that hands out only the owner's URL (Render) leaves XOLOTL_DATABASE_URL unset
# and sets this: the app URL is then the admin URL signing in as xolotl_app with it.
# XOLOTL_APP_DB_PASSWORD=
# libpq's connect timeout, in seconds (2 to 300), for every database connection.
# XOLOTL_DATABASE_CONNECT_TIMEOUT_SECONDS=10
XOLOTL_ENV=dev
XOLOTL_JWT_SECRET=dev-only-insecure-jwt-secret-change-me-000000
# Base64 of 32 random bytes (openssl rand -base64 32). This is the public
# development default; XOLOTL_ENV=prod refuses it.
XOLOTL_MASTER_KEY=Q3xaj5ip97qqPuccPScQkr3L2tDWTbaQuT+NQ63KSqI=
XOLOTL_OBJECT_STORE=local
XOLOTL_OBJECT_STORE_ROOT=./data/local/objects
# Connector mode of a PROD tenant when a call names none; SANDBOX tenants always
# use mocks.
XOLOTL_CONNECTOR_MODE_DEFAULT=SANDBOX
XOLOTL_LOG_LEVEL=INFO
# Policy packs, unit seeds and holidays (the Docker image sets /app/policy-packs).
XOLOTL_PACKS_DIR=./policy-packs
# Lets `packs load` accept UNVERIFIED values; XOLOTL_ENV=prod refuses true.
XOLOTL_ALLOW_UNVERIFIED_PACK_VALUES=false
# Banxico SIE token; leave unset for demo mode
# XOLOTL_BANXICO_TOKEN=
# Daily UDI and FIX fetch, five-field cron, evaluated in America/Mexico_City.
XOLOTL_UNITS_FETCH_CRON=0 18 * * 1-5
# daily party retention sweep, five-field cron, UTC
XOLOTL_RETENTION_PURGE_CRON=0 3 * * *
# Network fetching of the shared lists; unset means true only when XOLOTL_ENV=prod.
# Elsewhere load files with `xolotl lists load-file`.
# XOLOTL_LISTS_FETCH_ENABLED=
# Per-tenant lists.poll job, five-field cron, UTC.
XOLOTL_LISTS_POLL_CRON=* * * * *
# Per HTTP request of a list download, in seconds (5 to 600).
XOLOTL_LISTS_FETCH_TIMEOUT_SECONDS=120
# Larger list downloads are refused (1 to 2048).
XOLOTL_LISTS_MAX_FILE_MB=300
# A new list version removing more than this share of entries is refused.
XOLOTL_LISTS_MAX_REMOVAL_RATIO=0.20
# Upload limits of a private list.
XOLOTL_PRIVATE_LIST_MAX_MB=20
XOLOTL_PRIVATE_LIST_MAX_ROWS=100000
# How often a process checks for newer active list versions, in seconds (1 or more).
XOLOTL_SCREENING_INDEX_REFRESH_SECONDS=30
# Tenants whose private-list index a process keeps in memory (1 or more).
XOLOTL_SCREENING_PRIVATE_SHARDS=64
# Load the screening index in the background at start-up; false loads it on the
# first screen.
XOLOTL_SCREENING_INDEX_WARM=true
# Delta entries per list-delta re-screen job (1 or more).
XOLOTL_SCREENING_DELTA_BATCH=200
# Parties per periodic, private-list or re-index re-screen job (1 or more).
XOLOTL_SCREENING_RESCREEN_BATCH=500
# Per-tenant monthly full re-screen, five-field cron, in America/Mexico_City.
XOLOTL_SCREENING_PERIODIC_CRON=0 2 1 * *
# The built console (console/dist) is served at "/" when this directory holds an
# index.html; the Docker image puts it at the default below. Leave unset locally.
# XOLOTL_STATIC_DIR=src/xolotl/static
